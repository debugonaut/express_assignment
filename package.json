{
  "name": "express-server-validation-portal",
  "version": "1.0.0",
  "description": "Server-side input validation and error handling using ExpressJS and Shadcn UI",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "build": "npm --prefix client install && npm --prefix client run build && mkdir -p public && cp -r client/dist/* public/",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "test": "NODE_ENV=test node --test server/tests/validation.test.js"
  },
  "workspaces": [
    "client"
  ],
  "keywords": [
    "express",
    "express-validator",
    "server-side-validation",
    "shadcn",
    "web-technology"
  ],
  "author": "Nupoor Deshpande (PRN: 202401100026)",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
